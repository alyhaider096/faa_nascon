# The organizer supplies the salt at runtime. Never commit the actual value.
# Put the real value only in an ignored local .env or the process environment.
DAY1_SALT=
DATABASE_URL=postgresql://nascon:nascon@db:5432/nascon
REDIS_URL=redis://redis:6379/0
# Comma-separated browser origins. Native Android clients do not require CORS.
CORS_ORIGINS=http://localhost:19006,http://127.0.0.1:19006
# Optional, only used with: docker compose --profile objectstore up -d
MINIO_ROOT_USER=nascon
MINIO_ROOT_PASSWORD=change-me
